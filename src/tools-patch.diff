+  // ===================================================================
+  // 12. lcmg_maintain - Trigger graph maintenance pipeline
+  // ===================================================================
+  api.registerTool({
+    name: "lcmg_maintain",
+    description: "Trigger knowledge graph maintenance: dedup, PageRank, community detection.",
+    parameters: Type.Object({}),
+    async execute() {
+      try {
+        const session = neo4j.session();
+        const start = Date.now();
+        const results: string[] = [];
+
+        // 1. Dedup: find and merge duplicate nodes by name
+        const dedupResult = await session.run(`
+          MATCH (n:Task|Skill|Event)
+          WHERE n.name IS NOT NULL
+          WITH n.name AS name, collect(n) AS nodes
+          WHERE size(nodes) > 1
+          UNWIND nodes AS node
+          WITH name, nodes[0] AS keep, node
+          WHERE node.id <> keep.id
+          MATCH (k {id: keep.id})
+          OPTIONAL MATCH (node)-[r]->(target)
+          MERGE (k)-[nr:CONTAINS]->(target)
+          SET nr.weight = COALESCE(nr.weight, 0) + COALESCE(r.weight, 0)
+          WITH node, keep
+          DETACH DELETE node
+          RETURN count(*) AS merged
+        `);
+        const mergedCount = Number(dedupResult.records[0]?.get('merged') ?? 0);
+        results.push(`Dedup merged: ${mergedCount} nodes`);
+
+        // 2. PageRank via Cypher's built-in
+        const pagerankResult = await session.run(`
+          CALL gds.pageRank.stream('myGraph')
+          YIELD nodeId, score
+          RETURN gds.util.asNode(nodeId).id AS id, score
+          ORDER BY score DESC LIMIT 20
+        `);
+        const topK = pagerankResult.records.length;
+        results.push(`PageRank top: ${topK} nodes`);
+
+        // 3. Community detection via GDS
+        const communityResult = await session.run(`
+          CALL gds.louvain.stream('myGraph')
+          YIELD nodeId, communityId
+          RETURN count(DISTINCT communityId) AS communities
+        `);
+        const communityCount = Number(communityResult.records[0]?.get('communities') ?? 0);
+        results.push(`Communities detected: ${communityCount}`);
+
+        const duration = Date.now() - start;
+        results.unshift(`# Graph Maintenance Report`, ``);
+        results.push(``);
+        results.push(`Duration: ${duration}ms`);
+        results.push(`[OK] Maintenance complete.`);
+
+        await session.close();
+        return { content: [{ type: "text" as const, text: results.join("\n") }] };
+      } catch (e) {
+        const msg = e instanceof Error ? e.message : String(e);
+        return { content: [{ type: "text" as const, text: "Maintenance failed: " + msg }], isError: true };
+      }
+    },
+  });
