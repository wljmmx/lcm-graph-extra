{
  "name": "@openclaw/lcm-dashboard",
  "version": "2.1.11",
  "private": true,
  "type": "module",
  "description": "LCM Dashboard: Vue 3 + Fastify 前台，覆盖性能监控/经验/记忆/维护四大模块",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.json --noEmit && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "start:dev": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^8.0.0",
    "@tanstack/vue-query": "^5.59.0",
    "echarts": "^5.5.0",
    "fastify": "^5.0.0",
    "naive-ui": "^2.40.0",
    "neo4j-driver": "^6.0.1",
    "typebox": "1.1.39",
    "vue": "^3.5.0",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.0.0",
    "happy-dom": "^20.10.6",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
