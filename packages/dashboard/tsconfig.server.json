{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "rootDir": "./server",
    "outDir": "./dist-server",
    "noEmit": false,
    "lib": ["ES2022"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "dist-client", "dist-server", "tests"]
}
