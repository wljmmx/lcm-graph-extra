{
  "id": "lcm-graph-extra",
  "name": "LCM Graph Extra",
  "description": "Dual-engine retrieval context engine: coordinates lossless-claw + qmd + graph-memory-pro for enhanced context assembly",
  "version": "0.2.0",
  "kind": "context-engine",
  "requiresPlugins": [
    "lossless-claw"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "lcmg_search",
      "lcmg_pin",
      "lcmg_import",
      "lcmg_experience_report",
      "lcmg_backup",
      "lcmg_restore",
      "lcmg_diagnose",
      "lcmg_sync",
      "lcmg_usage"
    ],
    "contextEngines": [
      "lcm-graph-extra"
    ]
  },
  "toolMetadata": {
    "lcmg_search": {
      "description": "Search across both qmd full-text index and Neo4j knowledge graph"
    },
    "lcmg_pin": {
      "description": "Mark an entity as permanent (excluded from memory decay)"
    },
    "lcmg_import": {
      "description": "Import historical data from LCM DB or files into the knowledge graph"
    },
    "lcmg_experience_report": {
      "description": "Extract experience summaries from the knowledge graph"
    },
    "lcmg_backup": {
      "description": "Backup memory data to a JSON file"
    },
    "lcmg_restore": {
      "description": "Restore memory data from a backup JSON file"
    },
    "lcmg_diagnose": {
      "description": "Run self-diagnostic and output system health analysis report"
    },
    "lcmg_sync": {
      "description": "Three-way data consistency check and repair (lossless-claw \u2194 Neo4j \u2194 files)"
    },
    "lcmg_usage": {
      "description": "View token usage reports and statistics"
    }
  },
  "uiHints": {
    "neo4j": {
      "label": "Neo4j Connection",
      "help": "Neo4j database connection for knowledge graph search"
    },
    "neo4j.uri": {
      "label": "Neo4j URI",
      "placeholder": "bolt://localhost:37687"
    },
    "neo4j.password": {
      "label": "Neo4j Password",
      "sensitive": true
    },
    "retrieval": {
      "label": "Retrieval Settings",
      "help": "Configure dual-engine search behavior"
    },
    "experience": {
      "label": "Experience Extraction Settings"
    }
  },
  "phaseContext": {
    "provides": [
      "lcmg_search",
      "lcmg_pin",
      "lcmg_sync",
      "lcmg_import",
      "lcmg_backup",
      "lcmg_restore",
      "lcmg_diagnose",
      "lcmg_experience_report",
      "lcmg_usage"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "neo4j": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "default": "bolt://localhost:37687"
          },
          "user": {
            "type": "string",
            "default": "neo4j"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "uri",
          "user",
          "password"
        ]
      },
      "retrieval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "qmd": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "searchLimit": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 20
              }
            }
          },
          "graph": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "searchLimit": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 20
              }
            }
          },
          "merger": {
            "type": "object",
            "properties": {
              "maxResults": {
                "type": "integer",
                "default": 10,
                "minimum": 1,
                "maximum": 30
              },
              "fuzzyMatchThreshold": {
                "type": "number",
                "default": 0.85,
                "minimum": 0,
                "maximum": 1
              },
              "decayHalfLifeDays": {
                "type": "integer",
                "default": 30,
                "minimum": 0,
                "description": "Memory decay half-life in days (0 = disabled)"
              }
            }
          }
        }
      },
      "experience": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "relevanceThreshold": {
            "type": "number",
            "default": 0.6,
            "minimum": 0,
            "maximum": 1
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "correction",
                "failure",
                "fix_success",
                "explicit_save"
              ]
            },
            "default": [
              "correction",
              "failure",
              "fix_success",
              "explicit_save"
            ]
          },
          "summaryMode": {
            "type": "string",
            "enum": [
              "async",
              "sync"
            ],
            "default": "async"
          }
        }
      },
      "async": {
        "type": "object",
        "properties": {
          "extraction": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "concurrency": {
                "type": "integer",
                "default": 1,
                "minimum": 1
              },
              "batchSize": {
                "type": "integer",
                "default": 5,
                "minimum": 1
              },
              "llm": {
                "type": "object",
                "properties": {
                  "apiKey": {
                    "type": "string"
                  },
                  "baseURL": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string",
                    "default": "qwen2.5:7b"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}