{
  "id": "lcm-graph-extra",
  "name": "LCM Graph Extra",
  "description": "Dual-engine retrieval context engine: coordinates lossless-claw + qmd + graph-memory-pro for enhanced context assembly",
  "version": "2.1.11",
  "kind": "context-engine",
  "requiresPlugins": [
    "lossless-claw"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "lcmg_search",
      "lcmg_pin",
      "lcmg_import",
      "lcmg_experience_report",
      "lcmg_backup",
      "lcmg_restore",
      "lcmg_diagnose",
      "lcmg_sync",
      "lcmg_qmd_status",
      "lcmg_get_document",
      "lcmg_batch_get",
      "lcmg_maintain",
      "lcmg_forget",
      "lcmg_distill",
      "lcmg_compact",
      "lcmg_reset_breaker",
      "lcmg_config_get",
      "lcmg_config_set",
      "lcmg_moa_reply"
    ]
  },
  "toolMetadata": {
    "lcmg_search": {
      "description": "Search across both qmd full-text index and Neo4j knowledge graph"
    },
    "lcmg_pin": {
      "description": "Mark an entity as permanent (excluded from memory decay)"
    },
    "lcmg_import": {
      "description": "Import historical data from LCM DB or files into the knowledge graph"
    },
    "lcmg_experience_report": {
      "description": "Extract experience summaries from the knowledge graph"
    },
    "lcmg_backup": {
      "description": "Backup memory data to a JSON file"
    },
    "lcmg_restore": {
      "description": "Restore memory data from a backup JSON file"
    },
    "lcmg_diagnose": {
      "description": "Run self-diagnostic and output system health analysis report"
    },
    "lcmg_sync": {
      "description": "Three-way data consistency check and repair (lossless-claw \u2194 Neo4j \u2194 files)"
    },
    "lcmg_qmd_status": {
      "description": "Check QMD MCP server health via status endpoint"
    },
    "lcmg_get_document": {
      "description": "Retrieve full text of a specific document by path or docid"
    },
    "lcmg_batch_get": {
      "description": "Batch retrieve multiple documents by their paths"
    },
    "lcmg_maintain": {
      "description": "Trigger knowledge graph maintenance pipeline"
    },
    "lcmg_forget": {
      "description": "Actively forget a node/experience (G-10 soft/hard mode)"
    },
    "lcmg_distill": {
      "description": "Manually trigger experience distillation (PENDING to DISTILLED)"
    },
    "lcmg_compact": {
      "description": "Manually trigger compaction for a specific conversation"
    },
    "lcmg_reset_breaker": {
      "description": "Reset circuit breaker for a subsystem (lcm/qmd/neo4j)"
    },
    "lcmg_config_get": {
      "description": "View runtime configuration (redacted)"
    },
    "lcmg_config_set": {
      "description": "Update a configuration field (whitelist-controlled)"
    },
    "lcmg_moa_reply": {
      "description": "Get the pre-computed MoA (Mixture of Agents) response synthesized by multiple reference models and an aggregator model"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "neo4j": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "default": "bolt://localhost:7687"
          },
          "user": {
            "type": "string",
            "default": "neo4j"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "uri",
          "user",
          "password"
        ]
      },
      "summaryStrategy": {
        "type": "string",
        "enum": [
          "strategy",
          "hybrid",
          "full"
        ],
        "default": "strategy"
      },
      "maxGraphDepth": {
        "type": "integer",
        "default": 10,
        "minimum": 1
      },
      "maxNodeCount": {
        "type": "integer",
        "default": 5000,
        "minimum": 1
      },
      "enableCrossFileLinkage": {
        "type": "boolean",
        "default": true
      },
      "crossReferenceRetentionDays": {
        "type": "integer",
        "default": 90,
        "minimum": 1
      },
      "maxTokens": {
        "type": "integer",
        "default": 65536,
        "minimum": 1
      },
      "budgetRatio": {
        "type": "number",
        "default": 0.3,
        "minimum": 0,
        "maximum": 1
      },
      "cliTimeout": {
        "type": "integer",
        "default": 30000
      },
      "cliFallbackSearchType": {
        "type": "string",
        "enum": [
          "search",
          "query"
        ],
        "default": "search"
      },
      "distillationIntervalMs": {
        "type": "integer",
        "default": 7200000
      },
      "tripletTimeoutMs": {
        "type": "integer",
        "default": 60000,
        "minimum": 1000,
        "description": "Timeout (ms) for afterTurn triplet extraction LLM call. Default 60s (tuned for local large models). Was 8s (too short for local qwen3.6 q_4)."
      },
      "llmTimeouts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rerankTimeoutMs": { "type": "integer", "default": 30000, "minimum": 1000, "description": "LLM rerank timeout (ms). Default 30s." },
          "judgeTimeoutMs": { "type": "integer", "default": 60000, "minimum": 1000, "description": "Cascade Tier2 LLM judgment fetch timeout (ms). Default 60s." },
          "validateTimeoutMs": { "type": "integer", "default": 45000, "minimum": 1000, "description": "G-8 experience relevance validation timeout (ms). Default 45s." },
          "summarizeTimeoutMs": { "type": "integer", "default": 90000, "minimum": 1000, "description": "Experience review summary timeout (ms). Default 90s." },
          "embedTimeoutMs": { "type": "integer", "default": 60000, "minimum": 1000, "description": "Embedding call timeout (ms). Default 60s." },
          "graphLlmTimeoutMs": { "type": "integer", "default": 90000, "minimum": 1000, "description": "Graph-adapter LLM (triplet extraction fetch fallback) timeout (ms). Default 90s." },
          "cascadeTier2Ms": { "type": "integer", "default": 60000, "minimum": 1000, "description": "Cascade Tier2 LLM Promise.race timeout (ms). Default 60s." },
          "cascadeTier3Ms": { "type": "integer", "default": 90000, "minimum": 1000, "description": "Cascade Tier3 tool verification timeout (ms). Default 90s." },
          "distillMs": { "type": "integer", "default": 120000, "minimum": 1000, "description": "Single experience distillation timeout (ms). Default 120s." }
        },
        "description": "LLM call timeouts (ms). Tuned for local large models (4090+64G+qwen3.6 q_4). NOTE: keepAlive is Ollama model memory retention time, NOT request timeout — they are unrelated."
      },
      "experienceTtlIntervalMs": {
        "type": "integer",
        "default": 86400000,
        "minimum": 60000,
        "description": "Experience TTL cleanup interval in milliseconds (default: 24h)"
      },
      "retrieval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "qmd": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mcpEndpoint": {
                "type": "string",
                "default": "http://127.0.0.1:8081",
                "description": "QMD MCP server base URL"
              }
            }
          },
          "graph": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "searchLimit": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 20
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "qmd": {
                "type": "integer",
                "default": 5,
                "minimum": 1
              },
              "graph": {
                "type": "integer",
                "default": 5,
                "minimum": 1
              },
              "exp": {
                "type": "integer",
                "default": 3,
                "minimum": 0
              }
            }
          }
        }
      },
      "experience": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "relevanceThreshold": {
            "type": "number",
            "default": 0.6,
            "minimum": 0,
            "maximum": 1
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "correction",
                "failure",
                "fix_success",
                "explicit_save"
              ]
            },
            "default": [
              "correction",
              "failure",
              "fix_success",
              "explicit_save"
            ]
          },
          "summaryMode": {
            "type": "string",
            "enum": [
              "async",
              "sync"
            ],
            "default": "async"
          }
        }
      },
      "lcmMonitor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "contextWindow": {
            "type": "integer",
            "default": 262144
          },
          "dedupRounds": {
            "type": "integer",
            "default": 24,
            "minimum": 1
          },
          "proactiveThreshold": {
            "type": "number",
            "default": 0.65,
            "minimum": 0,
            "maximum": 1
          },
          "highPressureThreshold": {
            "type": "number",
            "default": 0.85,
            "minimum": 0,
            "maximum": 1
          },
          "mediumPressureThreshold": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1
          },
          "systemPromptOverheadTokens": {
            "type": "integer",
            "default": 17000
          },
          "compactTokenBudget": {
            "type": "integer",
            "default": 114688
          },
          "compactTimeout": {
            "type": "integer",
            "default": 60000
          },
          "maxSummaryTokenRatio": {
            "type": "number",
            "default": 0.45,
            "minimum": 0,
            "maximum": 1
          },
          "retrievalLimits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "object",
                "properties": {
                  "qmd": {
                    "type": "integer",
                    "default": 5
                  },
                  "graph": {
                    "type": "integer",
                    "default": 5
                  },
                  "exp": {
                    "type": "integer",
                    "default": 3
                  }
                }
              },
              "medium": {
                "type": "object",
                "properties": {
                  "qmd": {
                    "type": "integer",
                    "default": 3
                  },
                  "graph": {
                    "type": "integer",
                    "default": 3
                  },
                  "exp": {
                    "type": "integer",
                    "default": 1
                  }
                }
              },
              "high": {
                "type": "object",
                "properties": {
                  "qmd": {
                    "type": "integer",
                    "default": 1
                  },
                  "graph": {
                    "type": "integer",
                    "default": 1
                  },
                  "exp": {
                    "type": "integer",
                    "default": 0
                  }
                }
              }
            }
          },
          "maxContextChars": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "integer",
                "default": 12000
              },
              "medium": {
                "type": "integer",
                "default": 6000
              },
              "high": {
                "type": "integer",
                "default": 1600
              }
            }
          }
        }
      },
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": "string",
            "sensitive": true
          },
          "baseURL": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "dimensions": {
            "type": "integer"
          },
          "keepAlive": {
            "type": "string",
            "description": "Ollama model memory retention time (e.g. '1h' = keep model loaded 1h after last request). This is NOT a request timeout — see llmTimeouts for request timeouts."
          }
        }
      },
      "distillationLlm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openclaw_hooks",
              "openai",
              "ollama",
              "custom"
            ],
            "default": "openclaw_hooks"
          },
          "model": {
            "type": "string",
            "default": "ollama/qwen3.6:27b"
          },
          "apiKey": {
            "type": "string",
            "sensitive": true
          },
          "baseURL": {
            "type": "string"
          },
          "keepAlive": {
            "type": "string",
            "default": "1h",
            "description": "Ollama model memory retention time (e.g. '1h' = keep model loaded 1h after last request). This is NOT a request timeout — see llmTimeouts for request timeouts."
          }
        }
      },
      "dashboardSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "host": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "port": {
            "type": "integer",
            "default": 7423,
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "llmProvider": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openclaw_hooks",
              "openai",
              "ollama",
              "custom"
            ],
            "default": "openclaw_hooks"
          },
          "model": {
            "type": "string",
            "default": "default"
          },
          "maxTokens": {
            "type": "integer",
            "default": 4096
          }
        }
      },
      "compaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "triggerThreshold": {
            "type": "integer",
            "default": 20000
          },
          "softThresholdTokens": {
            "type": "integer",
            "default": 163840
          },
          "keepRecentTokens": {
            "type": "integer",
            "default": 131072
          }
        }
      },
      "backupConfig": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "retentionDays": {
            "type": "integer",
            "default": 30
          },
          "maxBackups": {
            "type": "integer",
            "default": 10
          },
          "intervalHours": {
            "type": "integer",
            "default": 24
          },
          "backupDir": {
            "type": "string"
          }
        }
      },
      "ttl": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "retentionDays": {
            "type": "integer",
            "default": 90,
            "minimum": 1
          },
          "cleanupIntervalHours": {
            "type": "integer",
            "default": 24,
            "minimum": 1
          }
        }
      },
      "logging": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "silent",
              "fatal",
              "error",
              "warn",
              "info",
              "debug",
              "trace"
            ],
            "default": "info"
          },
          "file": {
            "type": "string"
          }
        }
      },
      "webhook": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dag_update",
                "compaction",
                "backup",
                "error",
                "circuit_breaker_trip",
                "debt_overflow",
                "gm_pro_unavailable"
              ]
            },
            "default": []
          }
        }
      },
      "moa": {
        "type": "object",
        "additionalProperties": false,
        "description": "MoA (Mixture of Agents) 多模型分层协作配置",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "是否启用 MoA 多模型协作"
          },
          "complexityThreshold": {
            "type": "number",
            "default": 0.6,
            "minimum": 0,
            "maximum": 1,
            "description": "任务复杂度阈值，超过此值触发 MoA"
          },
          "mode": {
            "type": "string",
            "enum": ["parallel", "serial"],
            "default": "serial",
            "description": "协作模式：parallel 并行 / serial 串行"
          },
          "referenceModels": {
            "type": "array",
            "description": "参考模型列表（2-4 个，从不同视角分析）",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["openai", "ollama", "deepseek", "custom", "openclaw_hooks"],
                  "default": "ollama"
                },
                "model": {
                  "type": "string",
                  "default": "qwen3.6:27b"
                },
                "temperature": {
                  "type": "number",
                  "default": 0.6,
                  "minimum": 0,
                  "maximum": 2
                },
                "systemPrompt": {
                  "type": "string",
                  "default": ""
                },
                "timeoutMs": {
                  "type": "integer",
                  "default": 900000,
                  "minimum": 1000,
                  "description": "超时时间（ms），本地模型建议 15-30 分钟"
                },
                "apiKey": {
                  "type": "string",
                  "sensitive": true
                },
                "baseURL": {
                  "type": "string"
                },
                "keepAlive": {
                  "type": "string",
                  "default": "1h"
                }
              }
            },
            "default": []
          },
          "aggregatorModel": {
            "type": "object",
            "additionalProperties": false,
            "description": "聚合模型配置（合并多个参考模型输出）",
            "properties": {
              "provider": {
                "type": "string",
                "enum": ["openai", "ollama", "deepseek", "custom", "openclaw_hooks"],
                "default": "ollama"
              },
              "model": {
                "type": "string",
                "default": "qwen3.6:27b"
              },
              "temperature": {
                "type": "number",
                "default": 0.3,
                "minimum": 0,
                "maximum": 2
              },
              "systemPrompt": {
                "type": "string",
                "default": ""
              },
              "timeoutMs": {
                "type": "integer",
                "default": 1200000,
                "minimum": 1000,
                "description": "超时时间（ms），聚合模型建议 20-30 分钟"
              },
              "apiKey": {
                "type": "string",
                "sensitive": true
              },
              "baseURL": {
                "type": "string"
              },
              "keepAlive": {
                "type": "string",
                "default": "1h"
              }
            }
          },
          "enabledTiers": {
            "type": "array",
            "description": "仅在指定压力层级下触发 MoA",
            "items": {
              "type": "string",
              "enum": ["low", "medium"]
            },
            "default": ["low"]
          }
        }
      }
    }
  },
  "uiHints": {
    "neo4j": {
      "label": "Neo4j Connection",
      "help": "Neo4j database connection for knowledge graph search"
    },
    "neo4j.uri": {
      "label": "Neo4j URI",
      "placeholder": "bolt://localhost:37687"
    },
    "neo4j.password": {
      "label": "Neo4j Password",
      "sensitive": true
    },
    "retrieval": {
      "label": "Retrieval Settings",
      "help": "Configure dual-engine search behavior"
    },
    "experience": {
      "label": "Experience Extraction Settings"
    }
  }
}
