{
  "id": "lcm-graph-extra",
  "name": "LCM Graph Extra",
  "description": "Dual-engine retrieval context engine: coordinates lossless-claw + qmd + graph-memory-pro for enhanced context assembly",
  "version": "2.1.8",
  "kind": "context-engine",
  "requiresPlugins": [
    "lossless-claw"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "lcmg_search",
      "lcmg_pin",
      "lcmg_import",
      "lcmg_experience_report",
      "lcmg_backup",
      "lcmg_restore",
      "lcmg_diagnose",
      "lcmg_sync",
      "lcmg_qmd_status",
      "lcmg_get_document",
      "lcmg_batch_get",
      "lcmg_maintain"
    ]
  },
  "toolMetadata": {
    "lcmg_search": {
      "description": "Search across both qmd full-text index and Neo4j knowledge graph"
    },
    "lcmg_pin": {
      "description": "Mark an entity as permanent (excluded from memory decay)"
    },
    "lcmg_import": {
      "description": "Import historical data from LCM DB or files into the knowledge graph"
    },
    "lcmg_experience_report": {
      "description": "Extract experience summaries from the knowledge graph"
    },
    "lcmg_backup": {
      "description": "Backup memory data to a JSON file"
    },
    "lcmg_restore": {
      "description": "Restore memory data from a backup JSON file"
    },
    "lcmg_diagnose": {
      "description": "Run self-diagnostic and output system health analysis report"
    },
    "lcmg_sync": {
      "description": "Three-way data consistency check and repair (lossless-claw \u2194 Neo4j \u2194 files)"
    },
    "lcmg_qmd_status": {
      "description": "Check QMD MCP server health via status endpoint"
    },
    "lcmg_get_document": {
      "description": "Retrieve full text of a specific document by path or docid"
    },
    "lcmg_batch_get": {
      "description": "Batch retrieve multiple documents by their paths"
    },
    "lcmg_maintain": {
      "description": "Trigger knowledge graph maintenance pipeline"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "neo4j": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "default": "bolt://localhost:37687"
          },
          "user": {
            "type": "string",
            "default": "neo4j"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "uri",
          "user",
          "password"
        ]
      },
      "retrieval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "qmd": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "searchLimit": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 20
              },
              "mcpEndpoint": {
                "type": "string",
                "default": "http://127.0.0.1:8081",
                "description": "QMD MCP server base URL"
              },
              "searchMode": {
                "type": "string",
                "enum": [
                  "mcp_fallback",
                  "cli_only"
                ],
                "default": "mcp_fallback",
                "description": "QMD search mode: mcp_fallback (prefer MCP, fall back to CLI) or cli_only"
              }
            }
          },
          "graph": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "searchLimit": {
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "maximum": 20
              }
            }
          },
          "merger": {
            "type": "object",
            "properties": {
              "maxResults": {
                "type": "integer",
                "default": 10,
                "minimum": 1,
                "maximum": 30
              },
              "fuzzyMatchThreshold": {
                "type": "number",
                "default": 0.85,
                "minimum": 0,
                "maximum": 1
              },
              "decayHalfLifeDays": {
                "type": "integer",
                "default": 30,
                "minimum": 0,
                "description": "Memory decay half-life in days (0 = disabled)"
              }
            }
          }
        }
      },
      "experience": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "relevanceThreshold": {
            "type": "number",
            "default": 0.6,
            "minimum": 0,
            "maximum": 1
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "correction",
                "failure",
                "fix_success",
                "explicit_save"
              ]
            },
            "default": [
              "correction",
              "failure",
              "fix_success",
              "explicit_save"
            ]
          },
          "summaryMode": {
            "type": "string",
            "enum": [
              "async",
              "sync"
            ],
            "default": "async"
          }
        }
      },
      "async": {
        "type": "object",
        "properties": {
          "extraction": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "concurrency": {
                "type": "integer",
                "default": 1,
                "minimum": 1
              },
              "batchSize": {
                "type": "integer",
                "default": 5,
                "minimum": 1
              },
              "llm": {
                "type": "object",
                "properties": {
                  "apiKey": {
                    "type": "string"
                  },
                  "baseURL": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string",
                    "default": "qwen2.5:7b"
                  }
                }
              }
            }
          }
        }
      },
      "lcmMonitor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "contextWindow": {
            "type": "integer",
            "default": 131072,
            "description": "\u6a21\u578b\u4e0a\u4e0b\u6587\u7a97\u53e3\u4e0a\u9650"
          },
          "proactiveThreshold": {
            "type": "number",
            "default": 0.65,
            "minimum": 0,
            "maximum": 1,
            "description": "\u89e6\u53d1\u540e\u53f0 compact \u7684 token \u6bd4\u4f8b\u9608\u503c"
          },
          "messageTriggerCount": {
            "type": "integer",
            "default": 24,
            "minimum": 1,
            "description": "\u89e6\u53d1\u540e\u53f0 compact \u7684\u6d88\u606f\u6570\u9608\u503c"
          },
          "highPressureThreshold": {
            "type": "number",
            "default": 0.85,
            "minimum": 0,
            "maximum": 1,
            "description": "\u9ad8\u538b\u529b token \u6bd4\u4f8b\u9608\u503c"
          },
          "mediumPressureThreshold": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1,
            "description": "\u4e2d\u538b\u529b token \u6bd4\u4f8b\u9608\u503c"
          },
          "compactTokenBudget": {
            "type": "integer",
            "default": 57344,
            "description": "\u5199\u5165 compact debt \u7684 token_budget"
          },
          "maxContextChars": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "integer",
                "default": 6000
              },
              "medium": {
                "type": "integer",
                "default": 3000
              },
              "high": {
                "type": "integer",
                "default": 800
              }
            }
          },
          "retrievalLimits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "object",
                "properties": {
                  "qmd": {
                    "type": "integer",
                    "default": 5
                  },
                  "graph": {
                    "type": "integer",
                    "default": 5
                  },
                  "exp": {
                    "type": "integer",
                    "default": 3
                  }
                }
              },
              "medium": {
                "type": "object",
                "properties": {
                  "qmd": {
                    "type": "integer",
                    "default": 3
                  },
                  "graph": {
                    "type": "integer",
                    "default": 3
                  },
                  "exp": {
                    "type": "integer",
                    "default": 1
                  }
                }
              },
              "high": {
                "type": "object",
                "properties": {
                  "qmd": {
                    "type": "integer",
                    "default": 1
                  },
                  "graph": {
                    "type": "integer",
                    "default": 1
                  },
                  "exp": {
                    "type": "integer",
                    "default": 0
                  }
                }
              }
            }
          }
        }
      },
      "cliFallbackSearchType": {
        "type": "string",
        "enum": [
          "search",
          "count"
        ],
        "default": "search",
        "description": "CLI fallback search type when MCP is unavailable"
      }
    }
  },
  "uiHints": {
    "neo4j": {
      "label": "Neo4j Connection",
      "help": "Neo4j database connection for knowledge graph search"
    },
    "neo4j.uri": {
      "label": "Neo4j URI",
      "placeholder": "bolt://localhost:37687"
    },
    "neo4j.password": {
      "label": "Neo4j Password",
      "sensitive": true
    },
    "retrieval": {
      "label": "Retrieval Settings",
      "help": "Configure dual-engine search behavior"
    },
    "experience": {
      "label": "Experience Extraction Settings"
    }
  }
}